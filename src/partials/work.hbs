{{#if resume.work.length}}
<div class="container work-container">
    {{> title value="Experience"}}

    {{#each (groupWork resume.work)}}
        <section class="item">
            {{#if (eq roles.length 1)}}
                {{#with roles.[0]}}
                    {{> section-header}}
                    {{#if position}}
                    <h4>{{position}}</h4>
                    {{/if}}
                    {{> work-body}}
                {{/with}}
            {{else}}
                {{> section-header}}
                {{#each roles}}
                    <div class="role">
                        <div class="section-header clearfix">
                            <h4 class="bold pull-left">{{position}}</h4>
                            {{> dates}}
                        </div>
                        {{> work-body}}
                    </div>
                {{/each}}
            {{/if}}
        </section>
    {{/each}}
</div>
{{/if}}
