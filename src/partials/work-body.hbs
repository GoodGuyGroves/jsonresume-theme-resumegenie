{{#if summary}}
<p class="summary">{{summary}}</p>
{{/if}}

{{#if highlights.length}}
<ul>
    {{#each highlights}}
    <li>{{.}}</li>
    {{/each}}
</ul>
{{/if}}

{{#if keywords.length}}
<div class="flex-container">
    {{#each keywords}}
        <h6 class="skill">{{.}}</h6>
    {{/each}}
</div>
{{/if}}
